          <path d="M2 78 L2 70 M2 78 L10 78" />
          <path d="M98 78 L98 70 M98 78 L90 78" />
        </g>

        <!-- Airframe: thin technical line work, not a filled cartoon body -->
        <g fill="none" stroke="#d5d8de" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="50" y1="39" x2="18" y2="17" />
          <line x1="50" y1="39" x2="82" y2="17" />
          <line x1="50" y1="45" x2="18" y2="61" />
          <line x1="50" y1="45" x2="82" y2="61" />
          <path d="M39 38 L50 31 L61 38 L61 46 L50 52 L39 46 Z" />
          <line x1="50" y1="52" x2="50" y2="57" />
        </g>
        <circle cx="50" cy="60" r="3.4" fill="none" stroke="#8fd7ff" stroke-width="1.2" />

        <g class="drone-companion__rotor" style="transform-origin: 18px 17px">
          <circle cx="18" cy="17" r="9" fill="none" stroke="#2f8a94" stroke-width="1" stroke-dasharray="1.5 3" opacity="0.75" />
        </g>
        <g class="drone-companion__rotor" style="transform-origin: 82px 17px">
          <circle cx="82" cy="17" r="9" fill="none" stroke="#2f8a94" stroke-width="1" stroke-dasharray="1.5 3" opacity="0.75" />
        </g>
        <g class="drone-companion__rotor" style="transform-origin: 18px 61px">
          <circle cx="18" cy="61" r="9" fill="none" stroke="#2f8a94" stroke-width="1" stroke-dasharray="1.5 3" opacity="0.75" />
        </g>
        <g class="drone-companion__rotor" style="transform-origin: 82px 61px">
          <circle cx="82" cy="61" r="9" fill="none" stroke="#2f8a94" stroke-width="1" stroke-dasharray="1.5 3" opacity="0.75" />
        </g>

        <circle cx="18" cy="17" r="3.6" fill="none" stroke="#d5d8de" stroke-width="1.3" />
        <circle cx="82" cy="17" r="3.6" fill="none" stroke="#d5d8de" stroke-width="1.3" />
        <circle cx="18" cy="61" r="3.6" fill="none" stroke="#d5d8de" stroke-width="1.3" />
        <circle cx="82" cy="61" r="3.6" fill="none" stroke="#d5d8de" stroke-width="1.3" />

        <circle cx="18" cy="17" r="1.1" fill="#ff5d5d" />
        <circle cx="18" cy="61" r="1.1" fill="#ff5d5d" />
        <circle cx="82" cy="17" r="1.1" fill="#4ee08a" />
        <circle cx="82" cy="61" r="1.1" fill="#4ee08a" />
      </svg>
    </span>
