  <button class="drone-companion" id="droneCompanion" aria-label="Scroll to top" title="Scroll to top">
    <span class="drone-companion__bob">
      <svg class="drone-companion__svg" viewBox="0 0 100 80" aria-hidden="true">
        <!-- Tracking-reticle corners, like a targeting/lock-on overlay -->
        <g class="drone-companion__reticle" stroke="#2f8a94" stroke-width="1" fill="none" opacity="0.75">
          <path d="M2 2 L2 10 M2 2 L10 2" />
